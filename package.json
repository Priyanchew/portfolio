{
  "name": "priyanchew-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3022",
    "build": "next build && node scripts/protect-osvi-docs.mjs",
    "build:check": "node scripts/check-build.mjs",
    "start": "serve out --listen tcp://127.0.0.1:3023 --no-clipboard --no-port-switching",
    "lint": "eslint src scripts *.mjs --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "icons:generate": "node scripts/generate-favicons.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "lucide-react": "^0.562.0",
    "motion": "^12.23.27",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.6",
    "serve": "^14.2.6",
    "typescript": "^5.9.3"
  },
  "description": "Priyanshu Choudhary\u2019s personal portfolio, work, and writing.",
